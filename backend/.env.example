# ── Core ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# When true (or when AWS creds are absent) the app uses mock OCR + AI so you can
# run the full flow with no cloud dependencies. Set to false to use live AWS.
MOCK_MODE=true

# ── Auth ──────────────────────────────────────────────
# Dev secret for local JWT signing. In production, auth is delegated to Cognito
# and this is replaced by JWKS verification (see middleware/auth.js).
JWT_SECRET=dev-only-change-me
JWT_ISSUER=sehat-local

# ── AWS (only needed when MOCK_MODE=false) ────────────
AWS_REGION=ap-south-1
S3_BUCKET=sehat-reports-dev
# Claude on Bedrock. Keep the model id in env so it is never hardcoded/stale.
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Database (Postgres / Aurora Serverless v2) ────────
DATABASE_URL=postgres://sehat:sehat@localhost:5432/sehat
